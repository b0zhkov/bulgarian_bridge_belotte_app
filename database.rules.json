{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('meta/host').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (data.exists() && !newData.exists() && (data.child('meta/host').val() === auth.uid || data.child('meta/onlineCount').val() <= 0 || (data.child('members').child(auth.uid).exists() && data.child('meta/onlineCount').val() <= 1))))",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{5}$/)",
        "meta": {
          ".read": "auth != null",
          "host": {
            ".write": "auth != null && newData.isString() && (data.val() === auth.uid ? root.child('rooms').child($code).child('members').child(newData.val()).exists() : (newData.val() === auth.uid && root.child('rooms').child($code).child('members').child(auth.uid).child('o').val() === true && root.child('rooms').child($code).child('members').child(data.val()).child('o').val() !== true))"
          },
          "status": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
          },
          "bots": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
          },
          "matchNo": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "onlineCount": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "lvl": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
            ".validate": "newData.val() === 'easy' || newData.val() === 'medium' || newData.val() === 'hard'"
          },
          "qm": {
            ".validate": "newData.isBoolean() && !data.exists()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms').child($code).child('meta/host').exists())",
            ".validate": "newData.hasChild('n')",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "t": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid && data.exists()",
              ".validate": "newData.val() === -1 || newData.val() === 0 || newData.val() === 1"
            },
            "j": {
              ".validate": "newData.isNumber()"
            },
            "ta": {
              ".validate": "newData.isNumber()"
            },
            "o": {
              ".validate": "newData.isBoolean()"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8 && !newData.val().contains('🤖')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seats": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "pub": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "hands": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString()"
          }
        },
        "intents": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['n', 'k'])",
            "n": {
              ".validate": "newData.isNumber()"
            },
            "k": {
              ".validate": "newData.val() === 'bid' || newData.val() === 'play' || newData.val() === 'ready'"
            },
            "v": {
              ".validate": "newData.isNumber()"
            },
            "x": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "emotes": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child(auth.uid).exists() && (!newData.exists() || !data.exists() || now >= data.child('t').val() + 2000)",
            ".validate": "newData.hasChildren(['e', 't']) && newData.child('t').val() === now",
            "e": {
              ".validate": "newData.isString() && newData.val().matches(/^(clap|laugh|wow|huff|thumbs|pray|think|fire|bravo|hayde|oops|gg)$/)"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "hostState": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
        ".write": "auth != null && (root.child('rooms').child($code).child('meta/host').val() === auth.uid || (!newData.exists() && (!root.child('rooms').child($code).exists() || root.child('rooms').child($code).child('meta/onlineCount').val() <= 0 || (root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/onlineCount').val() <= 1))))",
        ".validate": "newData.isString()"
      }
    },
    "queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 't', 'h'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "a": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8 && !newData.val().contains('🤖')"
        },
        "r": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val() || newData.val() === now)"
        },
        "h": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "room": {
          ".write": "auth != null && !data.exists() && newData.isString() && root.child('rooms').child(newData.val()).child('meta/host').val() === auth.uid && root.child('rooms').child(newData.val()).child('meta/qm').val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{5}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ratings": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (newData.exists() || data.child('r').val() >= 1000)",
        ".validate": "newData.hasChildren(['r', 'g', 'c', 'x', 't']) && newData.child('c').isString() && newData.child('x').isString() && newData.child('t').val() === now && (!data.exists() || now >= data.child('t').val() + 120000) && root.child('qresults').child(newData.child('c').val()).child(newData.child('x').val()).child($uid).exists() && root.child('qresults').child(newData.child('c').val()).child(newData.child('x').val()).child($uid).child('b').val() === (data.exists() ? data.child('r').val() : 1000) && newData.child('r').val() === root.child('qresults').child(newData.child('c').val()).child(newData.child('x').val()).child($uid).child('b').val() + root.child('qresults').child(newData.child('c').val()).child(newData.child('x').val()).child($uid).child('d').val() && newData.child('g').val() === (data.exists() ? data.child('g').val() : 0) + 1",
        "r": {
          ".validate": "newData.isNumber()"
        },
        "g": {
          ".validate": "newData.isNumber()"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{5}$/)"
        },
        "x": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "qresults": {
      "$code": {
        "$rid": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid && root.child('rooms').child($code).child('meta').child('qm').val() === true && now >= root.child('rooms').child($code).child('meta').child('createdAt').val() + 120000",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !newData.exists()",
            ".validate": "newData.hasChildren(['b', 'd']) && newData.child('b').isNumber() && newData.child('d').isNumber() && newData.child('d').val() >= -32 && newData.child('d').val() <= 32 && newData.child('b').val() === (root.child('ratings').child($uid).exists() ? root.child('ratings').child($uid).child('r').val() : 1000)",
            "b": {
              ".validate": "newData.isNumber()"
            },
            "d": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "ach": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$id": {
          ".validate": "$id.matches(/^[a-zA-Z0-9]{1,24}$/) && newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    }
  }
}
